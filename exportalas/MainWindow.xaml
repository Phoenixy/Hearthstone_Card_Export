<controls:MetroWindow x:Class="exportalas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Title="Gyűjtemény – Hearthstone Hungary"
        Icon="Internal/hshu-icon.ico"
        Width="520"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        BorderThickness="1"
        BorderBrush="#FF427FED"
        NonActiveBorderBrush="#FF427FED"
        UseLayoutRounding="True">

    <controls:MetroWindow.Resources>
        <SolidColorBrush x:Key="HshuBlue" Color="#FF427FED"/>
        <SolidColorBrush x:Key="HshuBlueDark" Color="#FF0E4262"/>
        <SolidColorBrush x:Key="HshuText" Color="#FF1F2328"/>
        <SolidColorBrush x:Key="HshuMuted" Color="#FF57606A"/>

        <Style x:Key="HshuButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource HshuBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HshuBlueDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource HshuButton}">
            <Setter Property="Background" Value="#FF6B7280"/>
        </Style>

        <Style x:Key="Card" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#EBFFFFFF"/>
            <Setter Property="BorderBrush" Value="#40427FED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="16,0,16,12"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource HshuText}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="BodyText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource HshuText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="MutedText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource HshuMuted}"/>
        </Style>
    </controls:MetroWindow.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Internal/bg-bright.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <StackPanel Margin="0,12,0,4">
            <Image Source="Internal/HSHU-logo.png" Height="90" HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <!-- Automatikus feltöltés -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Automatikus feltöltés a HSHU profilodba"/>
                    <TextBlock x:Name="LinkStatusText" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <StackPanel x:Name="TokenPanel">
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6">
                            <Run Text="Hozz létre egy plugin tokent a Hearthstone Hungary profilodban, és másold be ide."/>
                            <Hyperlink Click="TokenHelp_Click" Foreground="{StaticResource HshuBlue}">Token létrehozása</Hyperlink>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TokenBox" Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                         controls:TextBoxHelper.Watermark="Token beillesztése"/>
                            <Button x:Name="SaveTokenButton" Grid.Column="1" Style="{StaticResource HshuButton}"
                                    Content="Összekapcsolás" Click="SaveToken_Click"/>
                        </Grid>
                    </StackPanel>

                    <CheckBox x:Name="AutoUploadCheck" Margin="0,10,0,0" Foreground="{StaticResource HshuText}"
                              Content="Automatikus feltöltés, ha változik a gyűjteményem"
                              Checked="AutoUploadCheck_Changed" Unchecked="AutoUploadCheck_Changed"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="UploadNowButton" Style="{StaticResource HshuButton}" Content="Feltöltés most" Click="UploadNow_Click"/>
                        <Button x:Name="UnlinkButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="Leválasztás" Click="Unlink_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="UploadStatusText" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Kézi CSV export (a régi módszer) -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Exportálás CSV fájlba"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8"
                               Text="Ha nem szeretnéd összekapcsolni a profilodat: mentsd el a gyűjteményt CSV fájlba, és töltsd fel a Hearthstone Hungary-n a profilod gyűjtemény oldalán."/>
                    <Button x:Name="ExportButton" Style="{StaticResource HshuButton}" HorizontalAlignment="Left"
                            Content="Exportálás CSV fájlba" Click="Export_Click"/>
                </StackPanel>
            </Border>

            <!-- Verzió és frissítés -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VersionText" Grid.Column="0" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                        <Button x:Name="CheckUpdateButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                FontSize="12" Padding="10,4" Content="Frissítés keresése" Click="CheckUpdate_Click"/>
                    </Grid>
                    <CheckBox x:Name="AutoUpdateCheck" Margin="0,8,0,0" Foreground="{StaticResource HshuText}"
                              Content="Automatikus frissítés (ajánlott)"
                              Checked="AutoUpdateCheck_Changed" Unchecked="AutoUpdateCheck_Changed"/>
                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</controls:MetroWindow>
