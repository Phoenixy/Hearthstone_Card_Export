<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HSHU gyűjtemény plugin a Hearthstone Deck Trackerhez (HDT).

    Fordítás előtt a HDT saját DLL-jei kellenek a ..\lib\ mappába
    (HearthstoneDeckTracker.exe, HearthDb.dll, HearthMirror.dll, MahApps.Metro.dll, Newtonsoft.Json.dll).
    Ezt a tools\copy-hdt-libs.ps1 elvégzi a gépre telepített HDT-ből.
    Más helyről: dotnet build -p:HdtDir=C:\valahol\HDT\
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <RootNamespace>exportalas</RootNamespace>
    <!-- Ne nevezd át: a HDT a fájlnév + plugin név alapján jegyzi meg, hogy be van-e kapcsolva. -->
    <AssemblyName>exportalas</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- A HDT 1.53.0 óta 64 bites. AnyCPU kell, x86-ra fordítva a plugin be sem töltődik. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>Debug;Release</Configurations>
    <HdtDir Condition="'$(HdtDir)' == ''">$(MSBuildThisFileDirectory)..\lib\</HdtDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- A HDT ezeket maga hozza, ezért nem másoljuk a plugin mellé (Private=false). -->
    <Reference Include="HearthstoneDeckTracker">
      <HintPath>$(HdtDir)HearthstoneDeckTracker.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HearthDb">
      <HintPath>$(HdtDir)HearthDb.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HearthMirror">
      <HintPath>$(HdtDir)HearthMirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MahApps.Metro">
      <HintPath>$(HdtDir)MahApps.Metro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(HdtDir)Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- A .NET Framework 4.8 referencia-assemblyk NuGetből: így a Visual Studio targeting pack nélkül is fordul. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />

    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Internal\hshu-icon.ico" />
    <Resource Include="Internal\bg-bright.png" />
    <Resource Include="Internal\HSHU-logo.png" />
  </ItemGroup>

  <!-- Kiadáskor a ..\dist\exportalas.zip készül el; ezt kell a GitHub Release-hez csatolni. -->
  <Target Name="PackPluginZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PluginZipStaging>$(MSBuildThisFileDirectory)obj\zip\</PluginZipStaging>
      <PluginDistDir>$(MSBuildThisFileDirectory)..\dist\</PluginDistDir>
    </PropertyGroup>
    <RemoveDir Directories="$(PluginZipStaging)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginZipStaging)" />
    <MakeDir Directories="$(PluginDistDir)" />
    <ZipDirectory SourceDirectory="$(PluginZipStaging)" DestinationFile="$(PluginDistDir)exportalas.zip" Overwrite="true" />
    <Message Importance="high" Text="Plugin csomag: $(PluginDistDir)exportalas.zip" />
  </Target>

  <!-- Fejlesztéshez: dotnet build -p:DeployToHdt=true a HDT plugin mappájába másolja a DLL-t. -->
  <Target Name="DeployToHdtPlugins" AfterTargets="Build" Condition="'$(DeployToHdt)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AppData)\HearthstoneDeckTracker\Plugins\exportalas\" />
  </Target>

</Project>
