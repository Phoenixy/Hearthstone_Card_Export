<Window x:Class="HearthstoneHungary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hearthstone Hungary"
        Icon="Resources/hshu-icon.ico"
        Width="520"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- A színek (HshuBlue, HshuText, CardBackground…) és a háttérkép a Core\ThemeManager.cs-ben vannak,
             világos és sötét változatban; DynamicResource-szal hivatkozunk rájuk, hogy a Windows témaváltását kövessék. -->

        <Style x:Key="HshuButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource HshuBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HshuBlueDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource HshuButton}">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackground}"/>
        </Style>

        <Style x:Key="Card" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="16,0,16,12"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource HshuText}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="BodyText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource HshuText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="MutedText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource HshuMuted}"/>
        </Style>

        <!-- Saját jelölőnégyzet: a Windows alapértelmezettjének pipája sötét háttéren nem látszana. -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource HshuText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="2" BorderThickness="1" VerticalAlignment="Center"
                                    Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}">
                                <Path x:Name="Mark" Data="M 3,8 L 6.5,11.5 L 13,4.5" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource HshuBlue}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource HshuBlue}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource HshuBlue}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource HshuBlue}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Saját legördülő lista (a Windows alapértelmezettje sötét megjelenésben világos maradna). -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource HshuText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd" Background="Transparent" Padding="8,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HshuBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{DynamicResource HshuText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="MaxDropDownHeight" Value="240"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="Box" CornerRadius="2" BorderThickness="1"
                                                Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource HshuMuted}" StrokeThickness="1.6"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource HshuBlue}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource HshuBlue}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="9,0,28,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Fade"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Margin="0,2,0,0" BorderThickness="1" CornerRadius="2"
                                        Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fül: a kiválasztottat kék aláhúzás jelzi. -->
        <Style x:Key="TabButton" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource HshuMuted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Line" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="2,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource HshuText}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Line" Property="BorderBrush" Value="{DynamicResource HshuBlue}"/>
                                <Setter Property="Foreground" Value="{DynamicResource HshuText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBase}">
        <!-- A háttérkép átlátszó részein a WindowBase szín látszik (fehér / fekete). -->
        <Border Background="{DynamicResource WindowImage}"/>

        <StackPanel Margin="0,12,0,4">
            <Image Source="Resources/HSHU-logo.png" Height="72" HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <!-- A Hearthstone állapota -->
            <Border Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="GameDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="GameStatusText" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Fülek: alattuk mindig csak a kiválasztott rész látszik -->
            <Border Style="{StaticResource Card}" Padding="14,2,14,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="CollectionTab" Style="{StaticResource TabButton}" GroupName="MainTabs" Content="Gyűjtemény" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="DecksTab" Style="{StaticResource TabButton}" GroupName="MainTabs" Content="Paklik" Checked="Tab_Checked"/>
                    <RadioButton x:Name="StatsTab" Style="{StaticResource TabButton}" GroupName="MainTabs" Content="Statisztika" Checked="Tab_Checked"/>
                    <RadioButton x:Name="SettingsTab" Style="{StaticResource TabButton}" GroupName="MainTabs" Content="Beállítások" Checked="Tab_Checked"/>
                </StackPanel>
            </Border>

            <!-- A fülek tartalma egymáson van (a nem láthatók Hidden állapotban), így az ablak magassága fülváltáskor nem ugrál -->
            <Grid>
            <StackPanel x:Name="CollectionPanel">
            <!-- Automatikus feltöltés -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Gyűjtemény feltöltése a HSHU profilodba"/>
                    <TextBlock x:Name="LinkStatusText" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <!-- Nincs összekötve: egy gomb, a többi a böngészőben történik -->
                    <StackPanel x:Name="LinkPanel">
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8">
                            <Run Text="Kattints a gombra, és a böngészőben megnyíló oldalon hagyd jóvá. Egy profilhoz több gépet (pl. asztali gép és laptop) is összeköthetsz."/>
                            <Hyperlink Click="AppPage_Click" Foreground="{DynamicResource HshuLink}">Bővebben</Hyperlink>
                        </TextBlock>
                        <Button x:Name="LinkButton" Style="{StaticResource HshuButton}" HorizontalAlignment="Left"
                                Content="Összekötés a HSHU profiloddal" Click="Link_Click"/>
                    </StackPanel>

                    <!-- Összekötés közben: a kód, amit a böngészőben is látni kell -->
                    <StackPanel x:Name="LinkWaitPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource MutedText}" Text="Hagyd jóvá az összekötést a böngészőben megnyílt oldalon. Ott is ezt a kódot kell látnod:"/>
                        <TextBlock x:Name="LinkCodeText" FontFamily="Consolas" FontSize="24" FontWeight="Bold" Margin="0,6,0,8"
                                   Foreground="{DynamicResource HshuBlue}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CancelLinkButton" Style="{StaticResource SecondaryButton}" Content="Mégse" Click="CancelLink_Click"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Run Text="Nem nyílt meg?"/>
                                <Hyperlink Click="OpenLinkPage_Click" Foreground="{DynamicResource HshuLink}">Oldal megnyitása</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="UploadNowButton" Style="{StaticResource HshuButton}" Content="Feltöltés most" Click="UploadNow_Click"/>
                        <Button x:Name="UnlinkButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="Leválasztás" Click="Unlink_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="UploadStatusText" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            </StackPanel>

            <StackPanel x:Name="DecksPanel" Visibility="Hidden">
            <!-- Pakli feltöltése az oldalra -->
            <Border x:Name="DeckCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Pakli feltöltése a HSHU-ra"/>
                    <ComboBox x:Name="DeckCombo" Margin="0,0,0,10" SelectionChanged="DeckCombo_SelectionChanged"/>
                    <StackPanel x:Name="DeckButtons" Orientation="Horizontal">
                        <Button x:Name="DeckCreateButton" Style="{StaticResource HshuButton}" Content="Létrehozás az oldalon" Click="DeckCreate_Click"
                                ToolTip="A pakli egy kattintással létrejön a Hearthstone Hungary profilodban, a játékbeli nevével."/>
                        <Button x:Name="DeckBuilderButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="Megnyitás a pakli készítőben" Click="DeckBuilder_Click"
                                ToolTip="A pakli készítő nyílik meg a lapokkal: ott átnézheted, módosíthatod, és megadhatod a nevét, leírását."/>
                    </StackPanel>
                    <TextBlock x:Name="DeckStatusText" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            </StackPanel>

            <StackPanel x:Name="StatsPanel" Visibility="Hidden">
            <!-- A lejátszott meccsek a játék naplójából -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Győzelmek és vereségek"/>
                    <TextBlock x:Name="StatsSummaryText" Style="{StaticResource BodyText}"/>
                    <TextBlock x:Name="StatsRecentTitle" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,10,0,2" Text="Legutóbbi meccsek"/>
                    <TextBlock x:Name="StatsRecentText" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="StatsStatusText" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0">
                        <Run Text="Hogy a meccseidből mi jelenjen meg az oldalon (statisztika a paklijaidnál, aréna paklik, aréna futamok, és hogy mások is lássák-e), azt a profilodban állíthatod be."/>
                        <Hyperlink Click="SiteSettings_Click" Foreground="{DynamicResource HshuLink}">Megjelenítés beállítása a HSHU-n</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            </StackPanel>

            <StackPanel x:Name="SettingsPanel" Visibility="Hidden">
            <!-- Beállítások -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Beállítások"/>
                    <CheckBox x:Name="AutoUploadCheck" Content="Automatikus feltöltés, ha változik a gyűjteményem"
                              Checked="AutoUploadCheck_Changed" Unchecked="AutoUploadCheck_Changed"/>
                    <CheckBox x:Name="StartWithWindowsCheck" Margin="0,6,0,0" Content="Indítás a Windows-szal (a tálcán)"
                              Checked="StartWithWindowsCheck_Changed" Unchecked="StartWithWindowsCheck_Changed"/>
                    <CheckBox x:Name="NewsCheck" Margin="0,6,0,0" Content="Értesítés, ha új hír jelenik meg a Hearthstone Hungary-n"
                              Checked="NewsCheck_Changed" Unchecked="NewsCheck_Changed"/>
                    <CheckBox x:Name="TrackGamesCheck" Margin="0,6,0,0" Content="Statisztikák mentése és aréna paklik feltöltése*"
                              Checked="TrackGamesCheck_Changed" Unchecked="TrackGamesCheck_Changed"/>
                    <CheckBox x:Name="AutoUpdateCheck" Margin="0,6,0,0" Content="Automatikus frissítés (ajánlott)"
                              Checked="AutoUpdateCheck_Changed" Unchecked="AutoUpdateCheck_Changed"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0">
                        <Run Text="*Itt azt állítod be, mit csináljon az alkalmazás. Hogy az oldalon mi jelenjen meg (statisztika a paklijaidnál, aréna paklik, aréna futamok), és ki lássa, az a profilodban állítható:"/>
                        <Hyperlink Click="SiteSettings_Click" Foreground="{DynamicResource HshuLink}">beállítások a HSHU-n</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Verzió és frissítés -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VersionText" Grid.Column="0" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                        <Button x:Name="RestartButton" Grid.Column="1" Style="{StaticResource HshuButton}" Margin="0,0,8,0"
                                FontSize="12" Padding="10,4" Content="Újraindítás" Click="Restart_Click" Visibility="Collapsed"/>
                        <Button x:Name="CheckUpdateButton" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                FontSize="12" Padding="10,4" Content="Frissítés keresése" Click="CheckUpdate_Click"/>
                    </Grid>
                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0">
                        <Hyperlink Click="OpenLog_Click" Foreground="{DynamicResource HshuLink}">Napló megnyitása</Hyperlink>
                        <Run Text=" · "/>
                        <Hyperlink Click="Exit_Click" Foreground="{DynamicResource HshuLink}">Kilépés a programból</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
            </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
